{
  "name": "html-to-figma-local",
  "version": "0.9.3",
  "private": true,
  "description": "Local HTML and webpage capture to editable Figma layers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "serve": "node scripts/server.mjs",
    "capture": "node scripts/capture.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "capture:states": "node scripts/capture-states.mjs",
    "desktop:build": "node scripts/desktop/build.mjs",
    "desktop:package": "node scripts/desktop/package.mjs",
    "windows:prepare": "npm run build && node scripts/windows/prepare.mjs",
    "windows:package": "npm run windows:prepare && npm --prefix desktop/windows run dist",
    "windows:smoke": "node scripts/windows/smoke.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
